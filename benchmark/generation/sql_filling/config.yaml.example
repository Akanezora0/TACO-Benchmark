# SQL filling configuration (copy to config.yaml and fill in your API key)

llm:
  provider: "openai"
  model: "gpt-4o-mini"
  temperature: 0.1
  max_tokens: 8000
  max_workers: 4
  api_url: "https://api.openai.com/v1"
  api_key: "your-api-key-here"

processing:
  batch_size: 100
  timeout: 30
  max_retries: 3

storage:
  cache_path: "./cache"
  output_path: "./output"
  data_path: "./data"

logging:
  level: "INFO"
  file: "logs/sql_filling.log"
