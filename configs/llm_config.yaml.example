# Unified LLM configuration for TACO-Benchmark experiments and generation.
# Copy to configs/llm_config.yaml and set your API credentials.
#
# Environment variable overrides (optional):
#   TACO_API_KEY, TACO_API_URL, TACO_MODEL

llm:
  provider: "openai"
  model: "gpt-4o"
  temperature: 0.1
  max_tokens: 8000
  max_workers: 4
  api_url: "https://api.openai.com/v1"
  api_key: "your-api-key-here"
