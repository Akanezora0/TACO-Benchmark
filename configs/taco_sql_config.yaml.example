# TACO-SQL configuration file example

# Question rewriting configuration
question_rewriting:
  model_type: "api"  # "api" or "local"
  model_name: "gpt-4o"  # or "deepseek-chat", etc.
  api_key: "your_api_key_here"
  base_url: "https://api.openai.com/v1"  # or DeepSeek API URL
  prompt_template_path: "taco_sql/question_rewriting/prompts/rewriting_prompt.txt"
  temperature: 0.7
  max_tokens: 512

# Table linking configuration
table_linking:
  # Model paths
  query_model_path: "taco_sql/table_linking/models/query_model"
  table_model_path: "taco_sql/table_linking/models/table_model"
  
  # Data file paths
  merged_table_path: "taco_sql/table_linking/data/merged_table.csv"
  test_final_path: "taco_sql/table_linking/data/1000_final.json"
  keys_train_path: "taco_sql/table_linking/data/keys_train.json"
  keys_dev_path: "taco_sql/table_linking/data/keys_dev.json"
  
  # Retrieval parameters
  top_k: 5  # Return top-k relevant tables
  use_stopwords: true
  stopwords_path: "taco_sql/table_linking/data/cn_table_col_stopwords.txt"
  
  # Training configuration (if retraining is needed)
  training:
    epochs: 3
    batch_size: 16
    warmup_steps: 100
    learning_rate: 2e-5

# Query planning configuration
query_planning:
  model_type: "api"
  model_name: "gpt-4o"
  api_key: "your_api_key_here"
  base_url: "https://api.openai.com/v1"
  temperature: 0.3
  max_tokens: 1024

# SQL generation configuration
sql_generation:
  # Model type: "base_llm", "llm_based", "sft_based", "hybrid"
  model_type: "sft_based"
  
  # Base LLM configuration
  base_llm:
    model_name: "gpt-4o"
    api_key: "your_api_key_here"
    base_url: "https://api.openai.com/v1"
    temperature: 0.1
    max_tokens: 512
  
  # SFT model configuration
  sft_model:
    model_path: "models/codes-33b"
    device: "cuda:0"
    max_tokens: 512
    num_beams: 4
  
  # Schema filtering configuration
  schema_filter:
    enabled: true
    model_path: "models/sic_ckpts/sic_spider"
    max_tables: 7
    max_columns: 20

# Pipeline configuration
pipeline:
  # Enabled components
  enable_components:
    - "qr"  # Question Rewriting
    - "tl"  # Table Linking
    - "qp"  # Query Planning
    - "sg"  # SQL Generation
  
  # Execution mode
  execution_mode: "sequential"  # "sequential" or "parallel"
  
  # Error handling
  error_handling:
    max_retries: 3
    fallback_to_baseline: true

# Logging configuration
logging:
  level: "INFO"  # "DEBUG", "INFO", "WARNING", "ERROR"
  log_file: "logs/taco_sql.log"
  console_output: true
