**/*结果*.py

# Results (optional - can include sample results)
experiments/results/raw/
experiments/results/processed/
experiments/results/visualizations/

# Large result files (>100MB)
experiments/baselines/base_llm/results/*.json
experiments/baselines/**/results/*.json

# Large data files (>100MB)
