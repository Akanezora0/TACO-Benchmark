configs/llm_config.yaml
configs/taco_sql_config.yaml
configs/api_keys.json

# Log files
*.log
**/*.log
benchmark/generation/logs/

# Setup scripts at repo root are tracked; ignore ad-hoc shell scripts elsewhere
benchmark/**/*.sh
experiments/**/*.sh

